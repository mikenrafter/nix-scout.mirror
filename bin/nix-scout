#!/usr/bin/env bash
# nix-scout — scan modules/, materialize to /tmp, build .#scout, apply output.
set -euo pipefail

# When invoked via `sudo nix-scout`, $USER/$HOME are root's — resolve the real invoker.
if [[ "$(id -u)" -eq 0 && -n "${SUDO_USER:-}" ]]; then
  _SCOUT_USER="$SUDO_USER"
  _SCOUT_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
else
  _SCOUT_USER="${USER:-}"
  _SCOUT_HOME="${HOME:-}"
fi

NIX_SCOUT_PROFILE="${NIX_SCOUT_PROFILE:-/nix/var/nix/profiles/per-user/${_SCOUT_USER}/nix-scout}"
NIX_SCOUT_GCROOTS="${NIX_SCOUT_GCROOTS:-/nix/var/nix/gcroots/per-user/${_SCOUT_USER}/nix-scout}"
NIX_SCOUT_PATHS_FILE="${NIX_SCOUT_PATHS_FILE:-/var/lib/nix-scout/paths}"

_scout_lib() {
  local name="$1"
  local bin_lib
  bin_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/$name"
  if [[ -f "$bin_lib" ]]; then
    printf '%s' "$bin_lib"
    return 0
  fi
  return 1
}

# shellcheck source=../lib/scout-lib.sh
source "$(_scout_lib scout-lib.sh)"

_SCOUT_PATHS_MISSING_MSG="nix-scout: \${NIX_SCOUT_PATHS_FILE} is missing — install the nix-scout NixOS module (inputs.nix-scout.nixosModule <parent> <modulesRel>) and rebuild"

_load_paths_file() {
  if [[ ! -f "$NIX_SCOUT_PATHS_FILE" ]]; then
    echo "$_SCOUT_PATHS_MISSING_MSG" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$NIX_SCOUT_PATHS_FILE"
}

_resolve_modules() {
  _load_paths_file
  if [[ -z "${NIX_SCOUT_MODULES:-}" ]]; then
    echo "nix-scout: NIX_SCOUT_MODULES not set in ${NIX_SCOUT_PATHS_FILE}" >&2
    exit 1
  fi
  printf '%s' "$NIX_SCOUT_MODULES"
}

_resolve_parent() {
  _load_paths_file
  if [[ -z "${NIX_SCOUT_PARENT:-}" ]]; then
    echo "nix-scout: NIX_SCOUT_PARENT not set in ${NIX_SCOUT_PATHS_FILE}" >&2
    exit 1
  fi
  printf '%s' "$NIX_SCOUT_PARENT"
}

_require_user() {
  if [[ "$(id -u)" -eq 0 && -z "${SUDO_USER:-}" ]]; then
    echo "nix-scout: run as your user or via sudo, not directly as root" >&2
    exit 1
  fi
}

usage() {
  cat <<EOF
nix-scout — scout module switcher

Usage:
  nix-scout list                        List scout modules and their facets
  nix-scout switch <name> [NIX-FLAGS]   Materialize, build, and apply a scout module
  nix-scout switch <path>               Install a store path or flake installable into profile
  nix-scout status                      Show active scout profile + gc-roots + flakelet status
  nix-scout clear                       Clear scout profile and gc-roots
  nix-scout doctor                      Check flakelet integration health and print pass/fail report
  nix-scout completions fish            Print Fish shell completions to stdout

NIX-FLAGS are forwarded to 'nix build' (e.g. --show-trace, --option foo bar).
Flags may appear before or after <name>, or after -- for flags that take arguments.

Facets: a scout module may export any combination of:
  profile     packages.<system>.scout with bin/  — installed into scout nix profile
  home-files  packages.<system>.scout with home-files/ — files copied into \$HOME
  flakelet    flakelets.<attr> — registered with flakelet on rebuild; updated on switch

  switch fan-out: each facet script self-detects and no-ops if its output is absent.
  The flakelet entry must exist in /etc/flakelet.json (populated by nixos-rebuild).
  If the entry is missing: rebuild once to register, then retry nix-scout switch.

Environment (paths file: $NIX_SCOUT_PATHS_FILE — written by the nix-scout NixOS module):
  NIX_SCOUT_MODULES   (see paths file)
  NIX_SCOUT_PARENT    (see paths file)
  NIX_SCOUT_PATHS_FILE $NIX_SCOUT_PATHS_FILE
  NIX_SCOUT_PROFILE   $NIX_SCOUT_PROFILE
  NIX_SCOUT_GCROOTS   $NIX_SCOUT_GCROOTS

Rebuild prebuild passes systemRebuild=true into module outputs; 'switch' materializes
scout-context.nix with systemRebuild=false. Modules read mode via nix-scout.lib.readSystemRebuild
or by importing ./scout-context.nix (see lib/scout-module.nix).

module-mode: scout modules cannot set system-wide NixOS options (use core config).
EOF
}

_facet_tags() {
  local dir="$1" flake="$1/flake.nix" tags=""
  if grep -q 'home-files' "$flake" 2>/dev/null; then
    tags="${tags:+${tags} }home-files"
  fi
  if grep -qE '[^#]*packages\.' "$flake" 2>/dev/null && ! grep -q 'home-files' "$flake" 2>/dev/null; then
    tags="${tags:+${tags} }profile"
  fi
  if grep -q 'flakelets' "$flake" 2>/dev/null; then
    tags="${tags:+${tags} }flakelet"
  fi
  printf '%s' "${tags:-unknown}"
}

cmd_list() {
  local modules dir name tags
  modules="$(_resolve_modules)"
  if [[ ! -d "$modules" ]]; then
    echo "nix-scout: modules directory missing: $modules" >&2
    exit 1
  fi
  for dir in "$modules"/*; do
    [[ -d "$dir" && -f "$dir/flake.nix" ]] || continue
    name="$(basename "$dir")"
    tags="$(_facet_tags "$dir")"
    printf '%-20s  [%s]\n' "$name" "$tags"
  done | sort
}

_switch_module() {
  local name="$1"
  shift
  local nix_extra=("$@")
  local modules mod_dir mat store_path err_log nix_ok
  local has_pkg=false has_flt=false switch_rc=0

  modules="$(_resolve_modules)"
  mod_dir="$modules/$name"
  if [[ ! -f "$mod_dir/flake.nix" ]]; then
    echo "nix-scout: module not found: $name (expected $mod_dir/flake.nix)" >&2
    exit 1
  fi

  grep -qE '[^#]*(packages\.|\.scout)' "$mod_dir/flake.nix" 2>/dev/null && has_pkg=true
  grep -q 'flakelets' "$mod_dir/flake.nix" 2>/dev/null && has_flt=true

  if [[ "$has_pkg" != "true" && "$has_flt" != "true" ]]; then
    echo "nix-scout: $name/flake.nix has no recognisable facet (packages.*.scout or flakelets.*)" >&2
    exit 1
  fi

  echo "nix-scout: materialize $name from $mod_dir" >&2
  mat="$(env NIX_SCOUT_PARENT="$(_resolve_parent)" bash "$(_scout_lib materialize-module.sh)" "$mod_dir")"
  mat="${mat%%$'\n'*}"

  if [[ "$has_pkg" == "true" ]]; then
    echo "nix-scout: build $mat#scout" >&2
    err_log="$(mktemp)"
    store_path="$(nix build --no-link --print-out-paths --no-write-lock-file \
      "${nix_extra[@]}" "$mat#scout" 2>"$err_log")" \
      && nix_ok=true || nix_ok=false
    grep -Ev '^(warning: not writing modified lock file|• (Removed|Updated|Added) input|    '\''|  → )' \
      "$err_log" >&2 || true
    rm -f "$err_log"
    if [[ "$nix_ok" != "true" ]]; then
      echo "nix-scout: build failed for $name" >&2
      switch_rc=1
    else
      store_path="${store_path%%$'\n'*}"
      pin_gcroot "$store_path" "$name"
      env HOME="$_SCOUT_HOME" \
        USER="$_SCOUT_USER" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" \
        NIX_SCOUT_PROFILE="$NIX_SCOUT_PROFILE" \
        bash "$(_scout_lib apply-hm.sh)" "$store_path" "$name" \
        || { switch_rc=$?; echo "nix-scout: apply-hm failed for $name" >&2; }
      env HOME="$_SCOUT_HOME" \
        USER="$_SCOUT_USER" \
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}" \
        NIX_SCOUT_PROFILE="$NIX_SCOUT_PROFILE" \
        bash "$(_scout_lib apply-env.sh)" "$store_path" "$name" \
        || { switch_rc=$?; echo "nix-scout: apply-env failed for $name" >&2; }
    fi
  fi

  bash "$(_scout_lib apply-flakelet.sh)" "$name" "$mod_dir" \
    || { switch_rc=$?; echo "nix-scout: flakelet apply failed for $name" >&2; }

  return $switch_rc
}

_switch_path() {
  local arg="$1"
  _priv_mkdir "$(dirname "$NIX_SCOUT_PROFILE")"
  _priv_nix_env "$NIX_SCOUT_PROFILE" "$arg"
  _priv_mkdir "$NIX_SCOUT_GCROOTS"
  _priv_ln_sfn "$arg" "$NIX_SCOUT_GCROOTS/program"
  echo "nix-scout: installed $arg into scout profile"
}

cmd_switch() {
  local arg=""
  local nix_extra=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)
        shift
        nix_extra+=("$@")
        break
        ;;
      --*)
        nix_extra+=("$1")
        shift
        ;;
      *)
        if [[ -z "$arg" ]]; then
          arg="$1"
        else
          nix_extra+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$arg" ]]; then
    echo "nix-scout switch: missing argument" >&2
    usage >&2
    exit 1
  fi

  if [[ "$arg" == *"#"* ]] || [[ "$arg" == /nix/store/* ]] || [[ -d "$arg" && -d "$arg/bin" ]]; then
    _switch_path "$arg"
    return
  fi

  local modules="$(_resolve_modules)"
  if [[ -f "$modules/$arg/flake.nix" ]]; then
    _switch_module "$arg" "${nix_extra[@]}"
    return
  fi

  echo "nix-scout: module not found: $arg" >&2
  exit 1
}

cmd_status() {
  echo "=== nix-scout status ==="
  echo "Profile: $NIX_SCOUT_PROFILE"
  echo "Module Directory: $(_resolve_modules)"

  echo "Scouts Active:"
  if [[ -d "$NIX_SCOUT_GCROOTS" ]]; then
    local found=0 link name dest
    while IFS= read -r -d '' link; do
      name="$(basename "$link")"
      dest="$(readlink -f "$link" 2>/dev/null || printf '(dangling)')"
      printf '  %s → %s\n' "$name" "$dest"
      found=1
    done < <(find "$NIX_SCOUT_GCROOTS" -mindepth 1 -maxdepth 1 -print0 2>/dev/null || true)
    [[ "$found" -eq 1 ]] || echo "  (none)"
  else
    echo "  (none)"
  fi

  echo "Flakelet Services:"
  if command -v flakelet >/dev/null 2>&1; then
    flakelet status 2>/dev/null || echo "  (flakelet status unavailable)"
  else
    echo "  (flakelet not on PATH)"
  fi
}

cmd_clear() {
  if [[ -e "$NIX_SCOUT_PROFILE" ]]; then
    nix-env -p "$NIX_SCOUT_PROFILE" --uninstall '.*' 2>/dev/null || true
    rm -f "$NIX_SCOUT_PROFILE" "${NIX_SCOUT_PROFILE}-"* 2>/dev/null || true
  fi
  if [[ -d "$NIX_SCOUT_GCROOTS" ]]; then
    find "$NIX_SCOUT_GCROOTS" -mindepth 1 -delete 2>/dev/null || true
  fi
  FISH_CONF="${XDG_CONFIG_HOME:-${HOME:-~}/.config}/fish/conf.d/nix-scout.fish"
  if [[ -f "$FISH_CONF" ]]; then
    rm -f "$FISH_CONF"
    echo "nix-scout: removed $FISH_CONF"
  fi
  echo "nix-scout: cleared dedicated profile and gc-roots"
}

cmd_doctor() {
  local modules_dir eval_user access_lib
  local all_ok=true
  local -a module_names=()
  local failing_paths grant_rc check_rc

  modules_dir="$(_resolve_modules)"

  # shellcheck source=../lib/flakelet-access.sh
  access_lib="$(_scout_lib flakelet-access.sh)" || {
    echo "nix-scout: flakelet-access.sh missing from package" >&2
    return 1
  }
  # shellcheck source=/dev/null
  source "$access_lib"

  # ── 1. modules-path access (primary-gid-only model) ──────────────────────
  # Flakelet setuid/setgid without initgroups — sudo -u checks are misleading.
  eval_user=""
  if [[ -f /etc/flakelet/config.json ]]; then
    eval_user="$(jq -r '.eval_user // .user // empty' /etc/flakelet/config.json 2>/dev/null || true)"
  fi
  if [[ -z "$eval_user" ]]; then
    eval_user="flakelet"
  fi

  if [[ -f /etc/flakelet/config.json ]]; then
    mapfile -t module_names < <(jq -r '.services // {} | keys[]' /etc/flakelet/config.json 2>/dev/null || true)
  fi

  check_rc=0
  failing_paths="$(flakelet_access_check_tree "$modules_dir" "$eval_user" "${module_names[@]}")" || check_rc=$?
  if [[ "$check_rc" -eq 0 ]]; then
    printf '[ OK ]  eval-user (%s) can reach modules dir (primary gid): %s\n' "$eval_user" "$modules_dir"
  else
    printf '[FAIL]  eval-user (%s) cannot reach modules path with primary gid only\n' "$eval_user"
    if [[ -n "$failing_paths" ]]; then
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        printf '          blocked: %s\n' "$line"
      done <<< "$failing_paths"
    fi
    printf '        Mutating path access (o+x ancestors, o+rx modules)…\n'
    grant_rc=0
    flakelet_access_grant_tree "$modules_dir" "${module_names[@]}" || grant_rc=$?
    check_rc=0
    flakelet_access_check_tree "$modules_dir" "$eval_user" "${module_names[@]}" >/dev/null || check_rc=$?
    if [[ "$grant_rc" -eq 0 && "$check_rc" -eq 0 ]]; then
      printf '[ OK ]  path access repaired for %s\n' "$modules_dir"
    else
      printf '[FAIL]  path access still blocked after mutation\n'
      printf '        Fix: rebuild with nix-scout NixOS module (nix-scout-flakelet-access)\n'
      printf '        Or: bash %s grant %s\n' "$access_lib" "$modules_dir"
      all_ok=false
    fi
  fi

  # ── 2. state dir readable ────────────────────────────────────────────────
  if test -r /var/lib/flakelet 2>/dev/null; then
    printf '[ OK ]  /var/lib/flakelet is readable by current user\n'
  else
    printf '[FAIL]  /var/lib/flakelet is not readable by current user\n'
    printf '        Fix: sudo chgrp flakelet /var/lib/flakelet && sudo chmod g+rx /var/lib/flakelet\n'
    printf '        Or rebuild with the nix-scout NixOS module (adds nix-scout-flakelet-access activation script)\n'
    all_ok=false
  fi

  # ── 3. service status ────────────────────────────────────────────────────
  if test -r /var/lib/flakelet 2>/dev/null; then
    if command -v flakelet >/dev/null 2>&1; then
      local flt_json
      flt_json="$(flakelet status --json 2>/dev/null || true)"
      if [[ -n "$flt_json" ]]; then
        local failed
        # flakelet status --json is an array of service objects.
        failed="$(printf '%s' "$flt_json" | jq -r '
          .[]?
          | select(
              (.held != null)
              or ((.last_error != null) and (.last_error != ""))
            )
          | "\(.name): \(if .held != null then "held" else "error" end)"
        ' 2>/dev/null || true)"
        if [[ -z "$failed" ]]; then
          printf '[ OK ]  all flakelet services are healthy\n'
        else
          printf '[FAIL]  flakelet services in error/held state:\n'
          while IFS= read -r line; do
            printf '          %s\n' "$line"
          done <<< "$failed"
          printf '        Fix: check logs with: flakelet log <service-name>\n'
          printf '        After repairing path access, re-run: sudo flakelet update <name>\n'
          all_ok=false
        fi
      else
        printf '[ OK ]  no flakelet services registered (or status unavailable)\n'
      fi
    else
      printf '[ OK ]  flakelet not on PATH — skipping service status check\n'
    fi
  else
    printf '[ -- ]  service status skipped (state dir unreadable)\n'
  fi

  if [[ "$all_ok" == "true" ]]; then
    printf '\nnix-scout doctor: all checks passed\n'
  else
    printf '\nnix-scout doctor: one or more checks failed — see hints above\n'
    return 1
  fi
}

cmd_completions() {
  local shell="${1:-}"
  case "$shell" in
    fish)
      cat <<'FISH'
# Fish completions for nix-scout — generated by `nix-scout completions fish`

complete -c nix-scout -f

function __nix_scout_needs_subcommand
    not __fish_seen_subcommand_from list switch status clear doctor completions help --help -h
end

complete -c nix-scout -n __nix_scout_needs_subcommand -a list        -d 'List scout modules'
complete -c nix-scout -n __nix_scout_needs_subcommand -a switch      -d 'Materialize, build, and apply a scout module'
complete -c nix-scout -n __nix_scout_needs_subcommand -a status      -d 'Show active scout profile and gc-roots'
complete -c nix-scout -n __nix_scout_needs_subcommand -a clear       -d 'Clear scout profile and gc-roots'
complete -c nix-scout -n __nix_scout_needs_subcommand -a doctor      -d 'Check flakelet integration health'
complete -c nix-scout -n __nix_scout_needs_subcommand -a completions -d 'Print shell completions to stdout'
complete -c nix-scout -n __nix_scout_needs_subcommand -a help        -d 'Show usage'

complete -c nix-scout -n '__fish_seen_subcommand_from switch' \
    -a '(nix-scout list 2>/dev/null)' -d 'Scout module'

complete -c nix-scout -n '__fish_seen_subcommand_from completions' \
    -a fish -d 'Fish shell'
FISH
      ;;
    *)
      echo "nix-scout completions: unsupported shell '${shell:-<none>}' (supported: fish)" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  list)
    _require_user
    cmd_list
    ;;
  switch)
    _require_user
    shift
    cmd_switch "$@"
    ;;
  status)
    _require_user
    cmd_status
    ;;
  clear)
    _require_user
    cmd_clear
    ;;
  doctor)
    _require_user
    cmd_doctor
    ;;
  completions)
    shift
    cmd_completions "$@"
    ;;
  --help|-h|help)
    usage
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    echo "nix-scout: unknown subcommand '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
